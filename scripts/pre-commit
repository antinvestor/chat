#!/bin/bash
#
# Pre-commit hook for Chat app
# Runs dart format and dart fix on staged Dart files
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit hooks...${NC}"

# Get list of staged Dart files (excluding generated files)
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' | grep -v '\.g\.dart$' | grep -v '\.freezed\.dart$' | grep -v '\.pb\.dart$' || true)

if [ -z "$STAGED_DART_FILES" ]; then
    echo -e "${GREEN}No Dart files to check.${NC}"
    exit 0
fi

# Store the files in an array for processing
FILES_ARRAY=($STAGED_DART_FILES)
FILE_COUNT=${#FILES_ARRAY[@]}

echo -e "${YELLOW}Checking $FILE_COUNT Dart file(s)...${NC}"

# Run dart format on staged files
echo -e "${YELLOW}Running dart format...${NC}"
if ! dart format --set-exit-if-changed "${FILES_ARRAY[@]}" > /dev/null 2>&1; then
    echo -e "${YELLOW}Formatting files...${NC}"
    dart format "${FILES_ARRAY[@]}" > /dev/null
    # Re-stage the formatted files
    for file in "${FILES_ARRAY[@]}"; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
    echo -e "${GREEN}Files formatted and re-staged.${NC}"
fi

# Run dart fix to apply auto-fixes (including import ordering)
echo -e "${YELLOW}Running dart fix...${NC}"
for file in "${FILES_ARRAY[@]}"; do
    if [ -f "$file" ]; then
        dart fix --apply "$file" > /dev/null 2>&1 || true
        # Re-stage if there were changes
        if ! git diff --quiet "$file" 2>/dev/null; then
            git add "$file"
        fi
    fi
done

# Final verification - run flutter analyze on staged files only
echo -e "${YELLOW}Running analysis...${NC}"
ANALYSIS_ERRORS=0
for file in "${FILES_ARRAY[@]}"; do
    if [ -f "$file" ]; then
        if ! dart analyze "$file" 2>&1 | grep -q "No issues found"; then
            # Check if there are actual errors (not just info)
            ERROR_COUNT=$(dart analyze "$file" 2>&1 | grep -c " error " || true)
            if [ "$ERROR_COUNT" -gt 0 ]; then
                ANALYSIS_ERRORS=1
                echo -e "${RED}Analysis errors in $file${NC}"
                dart analyze "$file"
            fi
        fi
    fi
done

if [ "$ANALYSIS_ERRORS" -gt 0 ]; then
    echo -e "${RED}Analysis errors found. Please fix before committing.${NC}"
    exit 1
fi

echo -e "${GREEN}Pre-commit checks passed!${NC}"
exit 0
